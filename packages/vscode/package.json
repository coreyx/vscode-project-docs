{
  "name": "project-docs",
  "displayName": "Project Docs",
  "description": "Keep a repo's docs folder and an Obsidian vault folder in sync, with private notes kept out of the repo and PRIVATE.md decoding.",
  "version": "0.0.0",
  "publisher": "specdevship",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/coreyx/vscode-project-docs"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.cjs",
  "browser": "./dist/web.js",
  "activationEvents": [
    "workspaceContains:.project-docs.json"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Project Docs reads and writes files in the repo and the linked vault, so it only runs in trusted workspaces."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Project Docs syncs folders on the local disk."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "projectDocs.link",
        "title": "Link to Obsidian",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.unlink",
        "title": "Unlink",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.syncNow",
        "title": "Sync Now",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.pause",
        "title": "Pause Sync",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.resume",
        "title": "Resume Sync",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.proceedBulk",
        "title": "Proceed With Waiting Changes",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.cancelBulk",
        "title": "Cancel Waiting Changes",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.openConflict",
        "title": "Resolve Conflict",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.resolveConflict",
        "title": "Complete Merge",
        "category": "Project Docs",
        "icon": "$(check)"
      },
      {
        "command": "projectDocs.openFile",
        "title": "Open File",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.showLog",
        "title": "Show Log",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.setRule",
        "title": "Change Sync Rule",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.setRule.sync",
        "title": "sync",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.setRule.repoToVault",
        "title": "repo-to-vault",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.setRule.repoOnly",
        "title": "repo-only",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.trashRepoCopy",
        "title": "Move Repo Copy to Trash",
        "category": "Project Docs",
        "icon": "$(trash)"
      },
      {
        "command": "projectDocs.trashVaultCopy",
        "title": "Move Vault Copy to Trash",
        "category": "Project Docs",
        "icon": "$(trash)"
      },
      {
        "command": "projectDocs.replaceRealValues",
        "title": "Replace Real Values with Placeholders",
        "category": "Project Docs",
        "icon": "$(replace-all)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "projectDocs.unlink",
          "when": "projectDocs.linked"
        },
        {
          "command": "projectDocs.syncNow",
          "when": "projectDocs.linked"
        },
        {
          "command": "projectDocs.pause",
          "when": "projectDocs.linked"
        },
        {
          "command": "projectDocs.resume",
          "when": "projectDocs.linked"
        },
        {
          "command": "projectDocs.proceedBulk",
          "when": "projectDocs.linked"
        },
        {
          "command": "projectDocs.cancelBulk",
          "when": "projectDocs.linked"
        },
        {
          "command": "projectDocs.openConflict",
          "when": "false"
        },
        {
          "command": "projectDocs.resolveConflict",
          "when": "resourcePath in projectDocs.mergeOutputs"
        },
        {
          "command": "projectDocs.openFile",
          "when": "false"
        },
        {
          "command": "projectDocs.showLog",
          "when": "projectDocs.linked"
        },
        {
          "command": "projectDocs.setRule",
          "when": "projectDocs.linked && resourceExtname == .md"
        },
        {
          "command": "projectDocs.setRule.sync",
          "when": "false"
        },
        {
          "command": "projectDocs.setRule.repoToVault",
          "when": "false"
        },
        {
          "command": "projectDocs.setRule.repoOnly",
          "when": "false"
        },
        {
          "command": "projectDocs.trashRepoCopy",
          "when": "false"
        },
        {
          "command": "projectDocs.trashVaultCopy",
          "when": "false"
        },
        {
          "command": "projectDocs.replaceRealValues",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "projectDocs.resolveConflict",
          "when": "resourcePath in projectDocs.mergeOutputs",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "submenu": "projectDocs.ruleMenu",
          "when": "projectDocs.linked && resourceExtname == .md && !explorerResourceIsFolder",
          "group": "7_modification@9"
        }
      ],
      "projectDocs.ruleMenu": [
        {
          "command": "projectDocs.setRule.sync",
          "group": "rules@1"
        },
        {
          "command": "projectDocs.setRule.repoToVault",
          "group": "rules@2"
        },
        {
          "command": "projectDocs.setRule.repoOnly",
          "group": "rules@3"
        }
      ],
      "view/item/context": [
        {
          "command": "projectDocs.trashRepoCopy",
          "when": "view == projectDocs.problems && viewItem == projectDocs.problem.no-longer-synced",
          "group": "inline"
        },
        {
          "command": "projectDocs.trashVaultCopy",
          "when": "view == projectDocs.problems && viewItem == projectDocs.problem.repo-only-vault-copy",
          "group": "inline"
        },
        {
          "command": "projectDocs.replaceRealValues",
          "when": "view == projectDocs.problems && viewItem == projectDocs.problem.held-back.replace-real-values",
          "group": "inline"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "projectDocs.problems",
          "name": "Project Docs",
          "when": "projectDocs.linked"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "projectDocs.problems",
        "contents": "Nothing needs your attention: the repo and the vault are in sync.\n[Show Log](command:projectDocs.showLog)"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".project-docs.json",
        "url": "./schemas/project-docs.schema.json"
      }
    ],
    "submenus": [
      {
        "id": "projectDocs.ruleMenu",
        "label": "Project Docs Sync Rule"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "build:tests": "node build.mjs --tests",
    "test:vscode": "node build.mjs --tests && vscode-test"
  },
  "dependencies": {
    "@specdevship/project-docs-core": "*"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^12.0.3"
  }
}
