{
  "name": "project-docs",
  "displayName": "Project Docs",
  "description": "Keep a repo's docs folder and an Obsidian vault folder in sync, with private notes kept out of the repo and PRIVATE.md decoding.",
  "version": "0.0.0",
  "publisher": "specdevship",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/coreyx/vscode-project-docs"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.cjs",
  "browser": "./dist/web.js",
  "activationEvents": [
    "workspaceContains:.project-docs.json"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Project Docs reads and writes files in the repo and the linked vault, so it only runs in trusted workspaces."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Project Docs syncs folders on the local disk."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "projectDocs.link",
        "title": "Link to Obsidian",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.unlink",
        "title": "Unlink",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.syncNow",
        "title": "Sync Now",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.pause",
        "title": "Pause Sync",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.resume",
        "title": "Resume Sync",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.proceedBulk",
        "title": "Proceed With Waiting Changes",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.cancelBulk",
        "title": "Cancel Waiting Changes",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.openConflict",
        "title": "Resolve Conflict",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.resolveConflict",
        "title": "Complete Merge",
        "category": "Project Docs",
        "icon": "$(check)"
      },
      {
        "command": "projectDocs.openFile",
        "title": "Open File",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.showLog",
        "title": "Show Log",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.setRule",
        "title": "Change Sync Rule",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.setRule.sync",
        "title": "sync",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.setRule.repoToVault",
        "title": "repo-to-vault",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.setRule.repoOnly",
        "title": "repo-only",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.trashRepoCopy",
        "title": "Move Repo Copy to Trash",
        "category": "Project Docs",
        "icon": "$(trash)"
      },
      {
        "command": "projectDocs.trashVaultCopy",
        "title": "Move Vault Copy to Trash",
        "category": "Project Docs",
        "icon": "$(trash)"
      },
      {
        "command": "projectDocs.replaceRealValues",
        "title": "Replace Real Values with Placeholders",
        "category": "Project Docs",
        "icon": "$(replace-all)"
      },
      {
        "command": "projectDocs.toggleDecoded",
        "title": "Toggle Decoded View",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.showDecoded",
        "title": "Show Decoded (Real Values)",
        "category": "Project Docs",
        "icon": "$(eye)"
      },
      {
        "command": "projectDocs.showCoded",
        "title": "Show Coded",
        "category": "Project Docs",
        "icon": "$(eye-closed)"
      },
      {
        "command": "projectDocs.openDecodedPreview",
        "title": "Open Decoded Preview",
        "category": "Project Docs",
        "icon": "$(open-preview)"
      },
      {
        "command": "projectDocs.setupPrivateMd",
        "title": "Set up PRIVATE.md",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.installHooks",
        "title": "Install PRIVATE.md Commit Hooks",
        "category": "Project Docs"
      },
      {
        "command": "projectDocs.openInObsidian",
        "title": "Open in Obsidian",
        "category": "Project Docs"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "projectDocs.unlink",
          "when": "projectDocs.linked"
        },
        {
          "command": "projectDocs.syncNow",
          "when": "projectDocs.linked"
        },
        {
          "command": "projectDocs.pause",
          "when": "projectDocs.linked"
        },
        {
          "command": "projectDocs.resume",
          "when": "projectDocs.linked"
        },
        {
          "command": "projectDocs.proceedBulk",
          "when": "projectDocs.linked"
        },
        {
          "command": "projectDocs.cancelBulk",
          "when": "projectDocs.linked"
        },
        {
          "command": "projectDocs.openConflict",
          "when": "false"
        },
        {
          "command": "projectDocs.resolveConflict",
          "when": "resourcePath in projectDocs.mergeOutputs"
        },
        {
          "command": "projectDocs.openFile",
          "when": "false"
        },
        {
          "command": "projectDocs.showLog",
          "when": "projectDocs.linked"
        },
        {
          "command": "projectDocs.setRule",
          "when": "projectDocs.linked && resourceExtname == .md"
        },
        {
          "command": "projectDocs.setRule.sync",
          "when": "false"
        },
        {
          "command": "projectDocs.setRule.repoToVault",
          "when": "false"
        },
        {
          "command": "projectDocs.setRule.repoOnly",
          "when": "false"
        },
        {
          "command": "projectDocs.trashRepoCopy",
          "when": "false"
        },
        {
          "command": "projectDocs.trashVaultCopy",
          "when": "false"
        },
        {
          "command": "projectDocs.replaceRealValues",
          "when": "false"
        },
        {
          "command": "projectDocs.toggleDecoded",
          "when": "projectDocs.decodable"
        },
        {
          "command": "projectDocs.showDecoded",
          "when": "false"
        },
        {
          "command": "projectDocs.showCoded",
          "when": "false"
        },
        {
          "command": "projectDocs.openDecodedPreview",
          "when": "projectDocs.decodable"
        },
        {
          "command": "projectDocs.openInObsidian",
          "when": "projectDocs.linked"
        }
      ],
      "editor/title": [
        {
          "command": "projectDocs.resolveConflict",
          "when": "resourcePath in projectDocs.mergeOutputs",
          "group": "navigation"
        },
        {
          "command": "projectDocs.showDecoded",
          "when": "projectDocs.decodable && resourceScheme == file && resourceLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "projectDocs.showCoded",
          "when": "resourceScheme == project-docs-decoded",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "submenu": "projectDocs.ruleMenu",
          "when": "projectDocs.linked && resourceExtname == .md && !explorerResourceIsFolder",
          "group": "7_modification@9"
        }
      ],
      "projectDocs.ruleMenu": [
        {
          "command": "projectDocs.setRule.sync",
          "group": "rules@1"
        },
        {
          "command": "projectDocs.setRule.repoToVault",
          "group": "rules@2"
        },
        {
          "command": "projectDocs.setRule.repoOnly",
          "group": "rules@3"
        }
      ],
      "view/item/context": [
        {
          "command": "projectDocs.trashRepoCopy",
          "when": "view == projectDocs.problems && viewItem == projectDocs.problem.no-longer-synced",
          "group": "inline"
        },
        {
          "command": "projectDocs.trashVaultCopy",
          "when": "view == projectDocs.problems && viewItem == projectDocs.problem.repo-only-vault-copy",
          "group": "inline"
        },
        {
          "command": "projectDocs.replaceRealValues",
          "when": "view == projectDocs.problems && viewItem == projectDocs.problem.held-back.replace-real-values",
          "group": "inline"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "projectDocs.problems",
          "name": "Project Docs",
          "when": "projectDocs.linked"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "projectDocs.problems",
        "contents": "Nothing needs your attention: the repo and the vault are in sync.\n[Show Log](command:projectDocs.showLog)"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".project-docs.json",
        "url": "./schemas/project-docs.schema.json"
      }
    ],
    "submenus": [
      {
        "id": "projectDocs.ruleMenu",
        "label": "Project Docs Sync Rule"
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get Started with Project Docs",
        "description": "Keep your repo's docs and your Obsidian notes in sync, and keep private values out of the repo.",
        "steps": [
          {
            "id": "link",
            "title": "Link your docs to Obsidian",
            "description": "Pick the repo's docs folder and a folder in your vault. Edits in either app then sync to the other.\n[Link to Obsidian](command:projectDocs.link)",
            "media": {
              "markdown": "media/walkthrough/link.md"
            },
            "completionEvents": [
              "onCommand:projectDocs.link"
            ]
          },
          {
            "id": "rules",
            "title": "Choose how each file syncs",
            "description": "Right-click a doc and pick a sync rule, or click the rule in the status bar.\n[Change Sync Rule](command:projectDocs.setRule)",
            "media": {
              "markdown": "media/walkthrough/rules.md"
            },
            "completionEvents": [
              "onCommand:projectDocs.setRule"
            ]
          },
          {
            "id": "privateMd",
            "title": "Keep private values out of the repo",
            "description": "PRIVATE.md maps placeholders in your docs to real values, and never leaves your machine.\n[Set up PRIVATE.md](command:projectDocs.setupPrivateMd)",
            "media": {
              "markdown": "media/walkthrough/private-md.md"
            },
            "completionEvents": [
              "onCommand:projectDocs.setupPrivateMd"
            ]
          },
          {
            "id": "decoded",
            "title": "Read coded docs with real values",
            "description": "Click the eye in a doc's title bar to see it with real values, in a view that can't be saved.\n[Toggle Decoded View](command:projectDocs.toggleDecoded)",
            "media": {
              "markdown": "media/walkthrough/decoded.md"
            },
            "completionEvents": [
              "onCommand:projectDocs.toggleDecoded",
              "onCommand:projectDocs.showDecoded"
            ]
          },
          {
            "id": "obsidian",
            "title": "Jump to the project in Obsidian",
            "description": "Open the project's folder note in Obsidian, which links back to this repo.\n[Open in Obsidian](command:projectDocs.openInObsidian)",
            "media": {
              "markdown": "media/walkthrough/obsidian.md"
            },
            "completionEvents": [
              "onCommand:projectDocs.openInObsidian"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "build:tests": "node build.mjs --tests",
    "test:vscode": "node build.mjs --tests && vscode-test"
  },
  "dependencies": {
    "@specdevship/project-docs-core": "*"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^12.0.3"
  }
}
